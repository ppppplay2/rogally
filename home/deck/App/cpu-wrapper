#!/bin/bash
set -euo pipefail

GOVERNOR_BIN="$HOME/App/cpu-governor"
GOV_PID=""

cleanup() {
    if [[ -n "$GOV_PID" ]] && kill -0 "$GOV_PID" 2>/dev/null; then
        kill -TERM -- -"$GOV_PID" 2>/dev/null || true
        wait "$GOV_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

setsid sudo -n "$GOVERNOR_BIN" &
GOV_PID=$!

"$@"
